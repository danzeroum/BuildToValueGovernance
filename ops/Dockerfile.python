# ═══════════════════════════════════════════════════════════════
# BuildToValue — Python Governance (CUDA single-stage)
# ═══════════════════════════════════════════════════════════════
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3-pip \
    build-essential cmake ninja-build libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && python3.11 -m pip install --upgrade pip

COPY python/ ./python/
RUN python3.11 -m pip install --no-cache-dir ./python/

RUN CMAKE_ARGS="-DGGML_CUDA=on" python3.11 -m pip install --no-cache-dir llama-cpp-python || \
    python3.11 -m pip install --no-cache-dir llama-cpp-python

COPY data/ ./data/

RUN groupadd -r btv && useradd -r -g btv -d /app btv \
    && mkdir -p /app/data/ledger /app/models /app/data/runtime /app/data/autogen-policies \
    && chown -R btv:btv /app
USER btv

EXPOSE 8000
VOLUME /app/models

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=60s \
    CMD python3.11 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["python3.11", "-m", "uvicorn", "buildtovalue.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
