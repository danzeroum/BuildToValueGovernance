# BuildToValue — environment template
#
# Copy to .env and fill in real values. Do NOT commit .env.
#
# Generate a fresh HMAC key:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Deployment environment: development | staging | production
# In production, get_hmac_key() refuses to start without a real key.
BTV_ENV=development

# HMAC-SHA256 key used for verdict signing and policy integrity.
# REQUIRED in production. Rotate quarterly. Never reuse across environments.
BTV_HMAC_KEY=

# Comma-separated list of allowed CORS origins.
# REQUIRED in production. Example: https://app.example.com,https://admin.example.com
BTV_CORS_ORIGINS=

# Grafana admin password (Docker compose only). Generate a strong value.
GF_ADMIN_PASSWORD=
