FROM python:3.11-slim
WORKDIR /app
COPY python/ /app/python/
RUN pip install --no-cache-dir streamlit requests pyyaml pydantic
ENV BTV_GATEWAY_URL=http://gateway:8080
ENV BTV_GOVERNANCE_URL=http://governance:8000
EXPOSE 8501
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1
CMD ["streamlit", "run", "python/buildtovalue/dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
