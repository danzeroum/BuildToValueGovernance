FROM python:3.11-slim
WORKDIR /app

COPY python/ ./python/
RUN pip install --no-cache-dir ./python/
RUN pip install --no-cache-dir streamlit requests

COPY data/ ./data/

EXPOSE 8501
CMD ["streamlit", "run", "python/buildtovalue/dashboard/app.py", "--server.address", "0.0.0.0", "--server.headless", "true"]