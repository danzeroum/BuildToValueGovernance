{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BTV Grant Test Case Dataset Schema",
  "description": "JSON Schema for validating test case objects in the BTV Grant Decision Adapter adversarial test suite.",
  "type": "object",
  "required": ["id", "category", "description", "ground_truth", "linguistic_group", "risk_level", "proposal_data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(SV|SAN|HB|POL|MRC|LANG|BD|SID)-\\d{3}$",
      "description": "Test case identifier. Format: PREFIX-NNN where PREFIX is the category code."
    },
    "category": {
      "type": "string",
      "enum": ["structural", "sanitization", "hard_block", "policy", "mercy", "language", "bias_declaration", "session_id"],
      "description": "Test category mapping to the 8 adversarial test groups."
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "description": "Human-readable description of the test scenario."
    },
    "ground_truth": {
      "type": "string",
      "enum": [
        "ALLOW", "BLOCK", "EDUCATE", "INSPECT", "REDACT", "LOG",
        "HARD_BLOCK", "VALIDATION_ERROR", "DETERMINISTIC", "UNIQUE",
        "SALT_DEPENDENT", "FORMAT_VALID", "UUID_FALLBACK",
        "JONAS_ERROR", "RANGE_ERROR", "VALID"
      ],
      "description": "Expected outcome of the test case."
    },
    "linguistic_group": {
      "type": "string",
      "enum": ["en-US", "pt-BR", "es", "sw"],
      "description": "Primary linguistic group of the test proposal."
    },
    "risk_level": {
      "type": "string",
      "enum": ["n/a", "low", "moderate", "elevated", "high", "critical"],
      "description": "Expected composite_risk range for the test case."
    },
    "proposal_data": {
      "type": "object",
      "required": ["applicant_id", "title", "description"],
      "properties": {
        "applicant_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "stage": { "type": "string" },
        "budget_usd": { "type": "number", "minimum": 0 },
        "team_size": { "type": "integer", "minimum": 1 },
        "linguistic_group": { "type": "string" },
        "action_impact": { "type": "string" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "wallet_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "deliverables": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "extra": { "type": "object" }
      },
      "additionalProperties": false
    },
    "mock_verdict_override": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["ALLOW", "BLOCK", "EDUCATE", "INSPECT", "REDACT", "LOG"] },
            "hard_blocked": { "type": "boolean" },
            "contestable": { "type": "boolean" },
            "appeal_deadline_hours": { "type": "integer", "minimum": 0 },
            "mercy_applied": { "type": "boolean" },
            "composite_risk": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "trust_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          },
          "additionalProperties": false
        }
      ],
      "description": "Optional mock verdict to inject in place of a real BTV kernel call."
    },
    "should_raise": {
      "type": "boolean",
      "description": "If true, the test expects an exception to be raised."
    },
    "expected_exception": {
      "oneOf": [{ "type": "string" }, { "type": "null" }],
      "description": "Name of the expected exception class when should_raise is true."
    },
    "notes": {
      "type": "string",
      "description": "Optional free-form notes about the test case design rationale."
    }
  }
}
