<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>FRIA — Fundamental Rights Impact Assessment (EU AI Act Art. 27)</title>
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; margin: 40px; color: #333; line-height: 1.6; }
        h1 { color: #1a1a2e; border-bottom: 3px solid #e94560; padding-bottom: 10px; }
        h2 { color: #16213e; margin-top: 30px; }
        .section { margin: 20px 0; padding: 15px; border-left: 4px solid #0f3460; background: #f8f9fa; }
        .section-title { font-weight: bold; color: #0f3460; font-size: 1.1em; }
        .risk-low { border-left-color: #28a745; }
        .risk-medium { border-left-color: #ffc107; }
        .risk-high { border-left-color: #dc3545; }
        .risk-critical { border-left-color: #721c24; }
        .meta { background: #f0f4f8; padding: 15px; border-radius: 5px; margin: 20px 0; }
        .badge { display: inline-block; padding: 3px 10px; border-radius: 3px; font-size: 0.85em; font-weight: bold; }
        .badge-low { background: #d4edda; color: #155724; }
        .badge-medium { background: #fff3cd; color: #856404; }
        .badge-high { background: #f8d7da; color: #721c24; }
        .badge-critical { background: #721c24; color: white; }
        .manual { color: #dc3545; font-style: italic; }
        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 0.85em; color: #666; }
    </style>
</head>
<body>
    <h1>Fundamental Rights Impact Assessment (FRIA)</h1>
    <p><strong>Legal Basis:</strong> EU AI Act, Article 27</p>

    <div class="meta">
        <p><strong>Agent ID:</strong> {{ data.agent_id }}</p>
        <p><strong>Risk Level:</strong> <span class="badge badge-{{ data.risk_level | lower }}">{{ data.risk_level }}</span></p>
        <p><strong>Sector:</strong> {{ data.sector }}</p>
        <p><strong>Overall Risk:</strong> <span class="badge badge-{{ data.overall_risk | lower }}">{{ data.overall_risk }}</span></p>
        <p><strong>Sections:</strong> {{ data.auto_filled }}/{{ data.total_sections }} auto-filled, {{ data.manual_pending }} require manual review</p>
        <p><strong>Generated:</strong> {{ data.generated_at }}</p>
    </div>

    <h2>Summary</h2>
    <p>{{ data.summary }}</p>

    {% for section in data.sections %}
    <div class="section risk-{{ section.risk_indicator | lower }}">
        <p class="section-title">{{ section.section_id }}: {{ section.title }}</p>
        <p><strong>Question ({{ section.article_ref }}):</strong> {{ section.question }}</p>
        <p><strong>Assessment:</strong> {{ section.auto_answer }}</p>
        <p>
            <strong>Risk:</strong> <span class="badge badge-{{ section.risk_indicator | lower }}">{{ section.risk_indicator }}</span>
            {% if section.manual_required %}<span class="manual"> — Manual review required</span>{% endif %}
        </p>
    </div>
    {% endfor %}

    <div class="footer">
        <p>Document auto-generated by BuildToValue Governance OS.</p>
        <p>FRIA sections are populated with real forensic data from the immutable ledger where available.</p>
        <p>Generated at: {{ generated_at }}</p>
    </div>
</body>
</html>
